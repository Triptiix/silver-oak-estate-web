# Production: https://silveroakestate.online
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://example.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<YOUR_SUPABASE_ANON_KEY>"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="<YOUR_TURNSTILE_SITE_KEY>"

APP_ENV="development"
APP_TIMEZONE="Asia/Kolkata"
# Keep false until hosted migrations, Turnstile, booking tokens and Razorpay are verified together.
ONLINE_BOOKING_ENABLED="false"
PAYMENT_PROVIDER="razorpay"
PAYMENT_PROVIDER_MODE="test"
BOOKING_HOLD_MINUTES="10"
MANUAL_PAYMENT_HOLD_MINUTES="30"
DATABASE_CRON_ENABLED="true"
SUPABASE_SERVICE_ROLE_KEY="<YOUR_SUPABASE_SERVICE_ROLE_KEY>"
RAZORPAY_KEY_ID="rzp_test_<YOUR_KEY_ID>"
RAZORPAY_KEY_SECRET="<RAZORPAY_KEY_SECRET>"
RAZORPAY_WEBHOOK_SECRET="<YOUR_WEBHOOK_SECRET>"
TURNSTILE_SECRET_KEY="<YOUR_TURNSTILE_SECRET_KEY>"
BOOKING_TOKEN_SECRET="<YOUR_BOOKING_TOKEN_SECRET>"
ICAL_FEED_SECRET="<YOUR_ICAL_FEED_SECRET>"
EMAIL_API_KEY="<YOUR_EMAIL_API_KEY>"
# Must be a provider-verified transactional sender; this is not the contact mailbox.
EMAIL_SENDER="<VERIFIED_TRANSACTIONAL_SENDER>"
ADMIN_NOTIFICATION_RECIPIENTS="contact@silveroakestate.online"
CRON_SECRET="<YOUR_CRON_SECRET>"
# Optional for core and booking-test checks; required by the production-live preflight.
ERROR_MONITORING_DSN=""

# VERCEL=1 is provided by Vercel when system environment variables are enabled.
# Do not set it manually for local development.
